#!/bin/sh
set -eu

port="$(snapctl get port)"
case "$port" in
  ''|*[!0-9]*) echo 'port must be a number between 1 and 65535' >&2; exit 1 ;;
esac
if [ "${#port}" -gt 5 ] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo 'port must be between 1 and 65535' >&2
  exit 1
fi

addr="$(snapctl get addr)"
case "$addr" in
  ''|*[!A-Za-z0-9.:-]*) echo 'addr must be an IP address or hostname' >&2; exit 1 ;;
esac
case "$(snapctl get region)" in
  ''|*[!a-z0-9-]*) echo 'region must be an AWS region name' >&2; exit 1 ;;
esac
for cloud in aws azure gcp oci; do
  case "$(snapctl get "$cloud-endpoint")" in
    *[!][A-Za-z0-9.:/_-]*|*/) ;;
    http://?*|https://?*) continue ;;
  esac
  echo "$cloud-endpoint must be an http:// or https:// URL without a trailing slash" >&2
  exit 1
done
allow="$(snapctl get allow-unsafe-network-exposure)"
case "$allow" in
  true|false) ;;
  *) echo 'allow-unsafe-network-exposure must be true or false' >&2; exit 1 ;;
esac
# Floci UI has no login and no exposure guard of its own.
case "$addr" in
  localhost|::1) exposed=false ;;
  127.*[!0-9.]*) exposed=true ;;
  127.*) exposed=false ;;
  *) exposed=true ;;
esac
if [ "$exposed" = true ] && [ "$allow" != true ]; then
  echo 'Non-loopback listeners require allow-unsafe-network-exposure=true' >&2
  exit 1
fi

if snapctl services "$SNAP_INSTANCE_NAME.floci-ui" | grep -qwE 'enabled|active'; then
  snapctl restart "$SNAP_INSTANCE_NAME.floci-ui"
fi
